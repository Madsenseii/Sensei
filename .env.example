# Server Configuration
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Supabase / PostgreSQL Database Connection String (Session Pooler recommended)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourKeySecret

# Resend Transactional Email
RESEND_API_KEY=re_yourApiKeyHere
RESEND_FROM_EMAIL=orders@yourdomain.com

# Admin Route Security Secret
ADMIN_SECRET=your_admin_secret_token

# (Optional) Shiprocket Logistics Integration
SHIPROCKET_EMAIL=you@yourdomain.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=Primary

# (Optional) MSG91 SMS Gateway Integration
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=MADSEN
MSG91_TEMPLATE_ID=your_template_id
